{
  "$defs": {
    "RecordingContext": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "enum": [
            "hrv_acc",
            "ppg_dalia"
          ],
          "title": "Dataset",
          "type": "string"
        },
        "subject": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "hr_method": {
          "enum": [
            "rr_derived",
            "ecg_rpeaks_derived",
            "windowed_ecg_ground_truth"
          ],
          "title": "Hr Method",
          "type": "string"
        },
        "original_offset_seconds": {
          "minimum": 0,
          "title": "Original Offset Seconds",
          "type": "number"
        },
        "activity_label": {
          "anyOf": [
            {
              "enum": [
                "transition",
                "sitting",
                "stairs",
                "table_soccer",
                "cycling",
                "driving",
                "lunch",
                "walking",
                "working"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Label"
        },
        "hr_window_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hr Window Seconds"
        }
      },
      "required": [
        "dataset",
        "subject",
        "hr_method",
        "original_offset_seconds"
      ],
      "title": "RecordingContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "device_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Device Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "heart_rate": {
      "maximum": 65535,
      "minimum": 0,
      "title": "Heart Rate",
      "type": "integer"
    },
    "rr_intervals_ms": {
      "items": {
        "exclusiveMinimum": 0,
        "maximum": 64000,
        "type": "number"
      },
      "maxItems": 256,
      "title": "Rr Intervals Ms",
      "type": "array"
    },
    "source": {
      "default": "mock",
      "enum": [
        "mock",
        "polar_h10",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    },
    "sensor_contact": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sensor Contact"
    },
    "recording": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordingContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "user_id",
    "device_id",
    "session_id",
    "sequence",
    "timestamp",
    "heart_rate"
  ],
  "title": "TelemetryEvent",
  "type": "object"
}
