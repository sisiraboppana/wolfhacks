{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "device_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Device Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "heart_rate": {
      "maximum": 65535,
      "minimum": 0,
      "title": "Heart Rate",
      "type": "integer"
    },
    "rr_intervals_ms": {
      "items": {
        "exclusiveMinimum": 0,
        "maximum": 64000,
        "type": "number"
      },
      "maxItems": 256,
      "title": "Rr Intervals Ms",
      "type": "array"
    },
    "source": {
      "default": "mock",
      "enum": [
        "mock",
        "polar_h10",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    },
    "sensor_contact": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sensor Contact"
    }
  },
  "required": [
    "user_id",
    "device_id",
    "session_id",
    "sequence",
    "timestamp",
    "heart_rate"
  ],
  "title": "TelemetryEvent",
  "type": "object"
}
